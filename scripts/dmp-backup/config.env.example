# DMP internship backup configuration for qajava21 / collab
# Copy to config.env and fill in values (do not commit config.env).

# --- Output ---
BACKUP_ROOT=./backups
# Optional fixed stamp; default is UTC timestamp at run time
# BACKUP_STAMP=20260714T053000Z

# --- Access mode ---
# If KUBECONFIG is set and cluster is reachable, passwords can be read from secrets.
# KUBECONFIG=/path/to/kubeconfig_qajava21

# --- qajava21 PostgreSQL (data dump) ---
QAJAVA21_PG_HOST=postgres.qajava21.mosip.net
QAJAVA21_PG_PORT=5433
QAJAVA21_PG_USER=postgres
# Prefer setting in the environment: export QAJAVA21_PG_PASSWORD='...'
# QAJAVA21_PG_PASSWORD=

# Databases to dump (space-separated)
QAJAVA21_DATABASES="mosip_regprc mosip_credential mosip_idmap mosip_idrepo mosip_ida mosip_resident"

# --- Collab PostgreSQL (schema-only; no data) ---
COLLAB_PG_HOST=postgres.collab.mosip.net
COLLAB_PG_PORT=5433
COLLAB_PG_USER=postgres
# Prefer: export COLLAB_PG_PASSWORD='...'
# COLLAB_PG_PASSWORD=
COLLAB_DB_NAME=inji_certify_tan
COLLAB_SCHEMA_TABLE=self_registration
# Fully qualified: database inji_certify_tan, table/schema object self_registration
# If self_registration is a schema (not a table), set:
# COLLAB_SCHEMA_ONLY_NAME=self_registration
# COLLAB_TABLE_NAME=
# If it is schema.table:
COLLAB_SCHEMA_NAME=self_registration
COLLAB_TABLE_NAME=

# --- qajava21 MinIO ---
QAJAVA21_MINIO_URL=https://minio.qajava21.mosip.net
# API port (used when URL is host-only); console is usually 443
QAJAVA21_MINIO_API=http://minio.qajava21.mosip.net:9000
# Prefer kube secret minio/minio, or set explicitly:
# QAJAVA21_MINIO_ACCESS_KEY=admin
# QAJAVA21_MINIO_SECRET_KEY=
MINIO_ALIAS=qajava21
MINIO_NEWER_THAN=3d

# Buckets (space-separated)
MINIO_BUCKETS="landing-zone packet-manager idrepo mpolicy-default-abis mpolicy-default-auth mpolicy-default-digitalcard mpolicy-default-euin mpolicy-default-pdfcard mpolicy-default-qrcode mpolicy-default-reprint mpolicy-default-resident"

# --- Restore target MinIO (for restore-minio.sh) ---
# RESTORE_MINIO_URL=https://minio.target.example.net
# RESTORE_MINIO_ACCESS_KEY=
# RESTORE_MINIO_SECRET_KEY=
# RESTORE_MINIO_ALIAS=restore-target
# RESTORE_BACKUP_DIR=./backups/<stamp>/minio
